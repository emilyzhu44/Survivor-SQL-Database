USE survivor;

CREATE TABLE Season (
    SeasonID INT AUTO_INCREMENT PRIMARY KEY,
    SeasonName VARCHAR(100) NOT NULL,
    StartDate DATE,
    EndDate DATE,
    Winner VARCHAR(100)
);



CREATE TABLE Tribe (
    TribeID INT AUTO_INCREMENT PRIMARY KEY,
    TribeName VARCHAR(100) NOT NULL,
    SeasonID INT,
    FOREIGN KEY (SeasonID) REFERENCES Season(SeasonID)
);

CREATE TABLE Player (
    PlayerID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100),
    Major VARCHAR(100),
    Placement INT,
    TribeID INT,
    FOREIGN KEY (TribeID) REFERENCES Tribe(TribeID)
);

CREATE TABLE Player_Episode (
    PlayerID INT,
    EpisodeID INT,
    PRIMARY KEY (PlayerID, EpisodeID),
    FOREIGN KEY (PlayerID) REFERENCES Player(PlayerID),
    FOREIGN KEY (EpisodeID) REFERENCES Episode(EpisodeID)
);

CREATE TABLE Episode (
    EpisodeID INT AUTO_INCREMENT PRIMARY KEY,
    EpisodeName VARCHAR(100) NOT NULL,
    ReleaseDate DATE,
    SeasonID INT,
    FOREIGN KEY (SeasonID) REFERENCES Season(SeasonID)
);

CREATE TABLE Challenge (
    ChallengeID INT AUTO_INCREMENT PRIMARY KEY,
    ChallengeName VARCHAR(100) NOT NULL,
    ChallengeDescription TEXT,
    EpisodeID INT,
    FOREIGN KEY (EpisodeID) REFERENCES Episode(EpisodeID)
);

CREATE TABLE TribeChallenge (
    ChallengeID INT,
    TribeID INT,
    Result ENUM('Won', 'Lost'),
    PRIMARY KEY (ChallengeID, TribeID),
    FOREIGN KEY (ChallengeID) REFERENCES Challenge(ChallengeID),
    FOREIGN KEY (TribeID) REFERENCES Tribe(TribeID)
);

CREATE TABLE IndividualChallenge (
    ChallengeID INT,
    PlayerID INT,
    Result ENUM('Won', 'Lost'),
    PRIMARY KEY (ChallengeID, PlayerID),
    FOREIGN KEY (ChallengeID) REFERENCES Challenge(ChallengeID),
    FOREIGN KEY (PlayerID) REFERENCES Player(PlayerID)
);

CREATE TABLE Vote (
    VoteID INT AUTO_INCREMENT PRIMARY KEY,
    Date DATE,
    EpisodeID INT,
    VoterID INT,
    VotedForID INT,
    FOREIGN KEY (EpisodeID) REFERENCES Episode(EpisodeID),
    FOREIGN KEY (VoterID) REFERENCES Player(PlayerID),
    FOREIGN KEY (VotedForID) REFERENCES Player(PlayerID)
);

CREATE TABLE Advantage (
    AdvantageID INT AUTO_INCREMENT PRIMARY KEY,
    AdvantageType VARCHAR(100),
    PlayerID INT,
    FOREIGN KEY (PlayerID) REFERENCES Player(PlayerID)
);

